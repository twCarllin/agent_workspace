{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Agent|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agent-flow/scripts/eval_gates.py\" --hook",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "AGENT_FLOW_HARNESS=codex python3 \"$(git rev-parse --show-toplevel)/.agent-flow/scripts/session_start.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
